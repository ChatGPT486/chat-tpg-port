# Sample Nginx reverse proxy config for Chat TPG Portfolio
# Copy to /etc/nginx/sites-available/chat-tpg-portfolio
# then: sudo ln -s /etc/nginx/sites-available/chat-tpg-portfolio /etc/nginx/sites-enabled/
# then: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name your-domain.com www.your-domain.com;

    # Allow larger uploads (images/video sent as base64 JSON)
    client_max_body_size 50M;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# After this works on plain HTTP, run:
#   sudo certbot --nginx -d your-domain.com -d www.your-domain.com
# to get free HTTPS and have Certbot rewrite this file automatically.
